# Variables d'environnement de « Combien acheter ? »
#
# Copie ce fichier en .env et remplis les valeurs. .env n'est PAS versionne.
# Ce fichier-ci est versionne : il ne doit jamais contenir de vraie valeur.
#
# AUCUNE de ces variables n'est necessaire pour `npm test`, `npm run build`
# ou `npm start`. Elles ne servent qu'aux fonctions serverless de api/
# (lancees par `npm run dev:api` ou par Vercel en ligne) et a `npm run db:init`.

# Chaine de connexion Postgres Neon.
# Lue par : api/_db.ts, scripts/db-init.mjs
# Obtenir la valeur : neonctl connection-string --project-id <id>
# Forme attendue : postgresql://<user>:<motdepasse>@<host>.neon.tech/<base>?sslmode=require
# Attention : c'est un endpoint HTTP Neon, un Postgres local ne peut pas s'y substituer.
DATABASE_URL=

# --- Connexion Google de la partie admin ---
# Le formulaire public des invites (/f/:code) ne passe par rien de tout ca.

# Identifiants du client OAuth « Web application » de la console Google Cloud.
# https://console.cloud.google.com/apis/credentials
# L'URI de redirection autorisee est <origine>/api/auth/callback, a declarer pour
# CHAQUE domaine servi (prod, preprod, http://localhost:3000 pour vercel dev).
# Lues par : api/auth/google.ts, api/auth/callback.ts
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret qui signe le cookie de session. Une valeur aleatoire, differente entre
# preprod et production : la changer deconnecte tout le monde.
# Obtenir une valeur : openssl rand -base64 32
# Lue par : api/_auth.ts
SESSION_SECRET=

# Qui a le droit d'entrer, separes par des virgules. Une adresse complete
# (`antoine@exemple.com`) ou un domaine entier (`@lavialatte.com`). Vide, personne
# n'entre : une variable oubliee ne doit pas ouvrir l'admin a tout Google.
# Lue par : api/_auth.ts
ADMINS_GOOGLE=

# Origine publique de ce deploiement, sans slash final (https://exemple.com).
# A ne remplir que si l'URL reelle n'est pas devinable depuis la requete : les
# deploiements de preview ont des noms aleatoires que Google ne peut pas
# connaitre, donc on leur force l'URL stable de la preprod.
# Lue par : api/_auth.ts
URL_PUBLIQUE=

# Mot de passe commun, desormais en repli : il depanne quand la connexion Google
# est cassee et sert a appeler l'API depuis un terminal. Le client l'envoie dans
# l'en-tete x-mot-de-passe ; api/_db.ts le compare a cette valeur. Vide, le repli
# est simplement ferme.
# Lue par : api/_db.ts
MOT_DE_PASSE=

# --- Non gere ici ---
# VERCEL_OIDC_TOKEN est ecrit automatiquement dans .env.local par la CLI Vercel
# (`vercel dev`, `vercel link`). Ne le remplis pas a la main, ne le commite pas.
