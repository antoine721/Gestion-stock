# Variables d'environnement de « Combien acheter ? »
#
# Copie ce fichier en .env et remplis les valeurs. .env n'est PAS versionne.
# Ce fichier-ci est versionne : il ne doit jamais contenir de vraie valeur.
#
# AUCUNE de ces variables n'est necessaire pour `npm test`, `npm run build`
# ou `npm start`. Elles ne servent qu'aux fonctions serverless de api/
# (lancees par `npm run dev:api` ou par Vercel en ligne) et a `npm run db:init`.

# Chaine de connexion Postgres Neon.
# Lue par : api/_db.ts, scripts/db-init.mjs
# Obtenir la valeur : neonctl connection-string --project-id <id>
# Forme attendue : postgresql://<user>:<motdepasse>@<host>.neon.tech/<base>?sslmode=require
# Attention : c'est un endpoint HTTP Neon, un Postgres local ne peut pas s'y substituer.
DATABASE_URL=

# Mot de passe unique partage par toute l'app (il n'y a ni comptes ni sessions).
# Le client l'envoie dans l'en-tete x-mot-de-passe ; api/_db.ts le compare a cette valeur.
# En production il est defini dans les variables Vercel, pas dans un fichier.
# Lue par : api/_db.ts
MOT_DE_PASSE=

# --- Non gere ici ---
# VERCEL_OIDC_TOKEN est ecrit automatiquement dans .env.local par la CLI Vercel
# (`vercel dev`, `vercel link`). Ne le remplis pas a la main, ne le commite pas.
